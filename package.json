    "cors": "2.8.5",
    "helmet": "8.1.0",
    "express-rate-limit": "8.1.0",
    "node-cron": "4.2.1",
    "svix": "1.76.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.1",
    "@electric-sql/pglite": "0.3.10",
    "jsdom": "26.1.0",
    "prettier": "3.6.2"
